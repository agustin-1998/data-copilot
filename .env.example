# Copy this file to .env and fill in the values. Never commit .env.

# Web app model API: variable names are added once the provider ADR is accepted
# (see docs/adr/README.md). The local MCP entry point needs no key: it uses the
# model of the agent you connect.

# LangSmith tracing and evals
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=data-copilot

# PostgreSQL (docker compose)
DATABASE_HOST=localhost
# Change it if another PostgreSQL already uses 5432 on your machine.
DATABASE_PORT=5432
DATABASE_NAME=copilot
# Superuser: used only once, when the container creates the database.
POSTGRES_PASSWORD=
# Owner role: migrations and the seed. The agent never uses it.
COPILOT_OWNER_PASSWORD=
# Reader role: the only connection the agent uses. Read-only.
COPILOT_READER_PASSWORD=
