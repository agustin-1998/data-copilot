# Copy this file to .env and fill in the values. Never commit .env.

# Web app model API: variable names are added once the provider ADR is accepted
# (see docs/adr/README.md). The local MCP entry point needs no key: it uses the
# model of the agent you connect.

# LangSmith tracing and evals
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=data-copilot

# PostgreSQL
# Admin role: migrations and seed data only. The agent never uses it.
DATABASE_URL_ADMIN=
# Read-only role: the only connection the agent uses.
DATABASE_URL_READONLY=
